{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "mods/*/hooks/register.{ts,tsx}",
    "mods/*/tests/**/*.test.{ts,tsx}",
    "eslint/suppression-guard.ts"
